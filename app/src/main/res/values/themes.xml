<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Radioluxfmstreamer" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Splash Screen theme -->
    <style name="Theme.Radioluxfmstreamer.Splash" parent="Theme.SplashScreen">
        <!-- Deep navy background - neutral, works for both light/dark -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Use app launcher icon -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Post-splash theme -->
        <item name="postSplashScreenTheme">@style/Theme.Radioluxfmstreamer</item>
    </style>
</resources>